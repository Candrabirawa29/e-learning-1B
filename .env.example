# ==============================================================================
# CLASS 1-B TASK MANAGEMENT & E-LEARNING PLATFORM
# Environment Variables Example
# ==============================================================================
# Salin file ini menjadi .env.local (untuk aplikasi lokal) dan .env (untuk Prisma CLI):
# cp .env.example .env.local
# cp .env.example .env

# Prisma / PostgreSQL Connection Strings (dari Supabase Settings > Database)
# DATABASE_URL menggunakan connection pooling (port 6543 / pgbouncer)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL menggunakan direct connection (port 5432) untuk migration
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Public API (dari Supabase Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Server-Side Secret Key (JANGAN PERNAH EXPOSE KE CLIENT)
# Digunakan oleh server actions / admin API untuk manajemen user, reset password, dan seed
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Password Awal Default untuk Akun Mahasiswa Baru
# Mahasiswa akan dipaksa mengganti password saat pertama kali login
DEFAULT_INITIAL_PASSWORD="your_strong_default_password_here"
