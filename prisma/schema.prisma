// Prisma schema for Class 1-B Task Management & E-Learning Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MEMBER
  PJ
  ADMIN
}

enum TaskTargetType {
  ALL
  SPECIFIC
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaterialType {
  PDF
  DOC
  PPT
  LINK
  NOTES
}

enum MaterialVisibility {
  PUBLIC
  AUTHENTICATED
}

enum ActivityAction {
  USER_LOGIN
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  TASK_ASSIGNED
  MATERIAL_UPLOADED
  MATERIAL_DELETED
  ASSIGNMENT_CREATED
  ASSIGNMENT_UPDATED
  ASSIGNMENT_DELETED
  SUBMISSION_CREATED
  ROLE_CHANGED
  PASSWORD_RESET
}

model Profile {
  id                 String            @id // Matches Supabase auth.users.id
  email              String            @unique
  name               String?
  avatarUrl          String?
  mustChangePassword Boolean           @default(true)
  isActive           Boolean           @default(true)
  activatedAt        DateTime?         // Diisi saat pertama ganti password, tidak pernah dihapus
  lastLoginAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  memberships          ClassMembership[]
  createdTasks         Task[]            @relation("TaskCreatedBy")
  assignedTasks        TaskAssignment[]
  taskProgresses       TaskProgress[]
  uploadedMaterials    Material[]        @relation("MaterialUploadedBy")
  createdAnnouncements Announcement[]    @relation("AnnouncementCreatedBy")
  activityLogs         ActivityLog[]     @relation("ActorLogs")
  coursePJs            CoursePJ[]        @relation("CoursePJUser")

  @@map("profiles")
}

model Class {
  id          String   @id @default(uuid())
  name        String   @default("Kelas 1-B")
  code        String   @unique @default("1-B")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       ClassMembership[]
  courses       Course[]
  tasks         Task[]
  announcements Announcement[]

  @@map("classes")
}

model ClassMembership {
  id        String   @id @default(uuid())
  classId   String
  profileId String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([classId, profileId])
  @@index([classId])
  @@index([profileId])
  @@index([role])
  @@map("class_memberships")
}

model Course {
  id          String   @id @default(uuid())
  classId     String
  name        String
  code        String?
  description String?
  lecturer    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  topics      Topic[]
  materials   Material[]
  tasks       Task[]
  schedules   CourseSchedule[]
  pjs         CoursePJ[]

  @@index([classId])
  @@map("courses")
}

model CourseSchedule {
  id          String   @id @default(uuid())
  courseId    String
  dayOfWeek   Int      // 1 (Senin) - 7 (Minggu)
  startMinute Int      // Menit sejak tengah malam (0 - 1439)
  endMinute   Int      // Menit sejak tengah malam (0 - 1439)
  room        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([dayOfWeek])
  @@map("course_schedules")
}

model CoursePJ {
  id        String   @id @default(uuid())
  courseId  String
  userId    String
  createdAt DateTime @default(now())

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      Profile  @relation("CoursePJUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@map("course_pjs")
}

model Topic {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materials Material[]

  @@index([courseId])
  @@index([order])
  @@map("topics")
}

model Material {
  id           String             @id @default(uuid())
  courseId     String
  topicId      String?            // null = "Umum"
  title        String
  description  String?
  materialType MaterialType       @default(PDF)
  provider     String             @default("CLOUDINARY") // CLOUDINARY | EXTERNAL
  storagePath  String?
  fileUrl      String?
  publicId     String?            // Cloudinary publicId
  fileName     String?
  fileSize     Int?
  externalUrl  String?
  visibility   MaterialVisibility @default(PUBLIC)
  uploadedById String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic      Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  uploadedBy Profile  @relation("MaterialUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([topicId])
  @@index([visibility])
  @@index([uploadedById])
  @@index([createdAt])
  @@map("materials")
}

model Task {
  id            String         @id @default(uuid())
  classId       String
  courseId      String?
  title         String
  description   String?
  status        TaskStatus     @default(TODO)
  priority      TaskPriority   @default(MEDIUM)
  deadline      DateTime?
  targetType    TaskTargetType @default(ALL)
  createdById   String
  attachmentUrl String?
  submissionUrl String?        // URL pengumpulan tugas (validasi: hanya https)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  course      Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy   Profile          @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  assignments TaskAssignment[]
  progresses  TaskProgress[]

  @@index([classId])
  @@index([courseId])
  @@index([status])
  @@index([priority])
  @@index([deadline])
  @@index([targetType])
  @@index([createdById])
  @@map("tasks")
}

model TaskAssignment {
  id        String   @id @default(uuid())
  taskId    String
  profileId String
  createdAt DateTime @default(now())

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([taskId, profileId])
  @@index([taskId])
  @@index([profileId])
  @@map("task_assignments")
}

model TaskProgress {
  id        String     @id @default(uuid())
  taskId    String
  profileId String
  status    TaskStatus @default(TODO)
  progress  Int        @default(0)
  notes     String?
  updatedAt DateTime   @updatedAt

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([taskId, profileId])
  @@index([taskId])
  @@index([profileId])
  @@index([status])
  @@map("task_progress")
}

model Announcement {
  id          String   @id @default(uuid())
  classId     String
  title       String
  content     String
  isPinned    Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy Profile @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([publishedAt])
  @@index([isPinned])
  @@index([createdById])
  @@map("announcements")
}

model ActivityLog {
  id         String         @id @default(uuid())
  actorId    String?
  action     ActivityAction
  entityType String
  entityId   String?
  metadata   String?
  createdAt  DateTime       @default(now())

  actor Profile? @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("activity_logs")
}
